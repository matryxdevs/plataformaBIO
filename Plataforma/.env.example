ADMIN_LOGIN=admin
ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_UNICA_FORTE
# true em produção HTTPS; false apenas para HTTP local
COOKIE_SECURE=false
# DATA_DIR=/caminho/absoluto/gravavel/persistente
# PORT=3000

# MySQL obrigatório em produção. Use os dados do banco criado na hospedagem.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=SEU_BANCO
DB_USER=SEU_USUARIO
DB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_BANCO
# Ative TLS se exigido pelo provedor (recomendado para conexões remotas).
DB_SSL=false
# DB_SSL_CA_FILE=/caminho/para/ca.pem

# Opcional: intervalo de heartbeat do MySQL (ms); padrão 5000
# DB_KEEPALIVE_MS=5000

# Cadastro de colaboradores desativado pela V58.
SELF_REGISTRATION=false
